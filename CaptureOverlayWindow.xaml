<Window x:Class="ScreenShot.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False" Cursor="Cross"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CaptureBarButton" TargetType="Button">
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas" ClipToBounds="False"/>

        <Border x:Name="SizeLabel" Background="#CC000000" CornerRadius="2"
                Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeLabelText" Foreground="White" FontSize="12"
                       FontFamily="Consolas"/>
        </Border>

        <StackPanel x:Name="ActionBar" Orientation="Horizontal"
                    Visibility="Collapsed" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,0,16,16">
            <Button x:Name="BtnConfirm" Content="确认" Click="BtnConfirm_Click"
                    Style="{StaticResource CaptureBarButton}"
                    Background="#FF2BAC5A" Foreground="White"/>
            <Button x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"
                    Style="{StaticResource CaptureBarButton}"
                    Background="#FF555555" Foreground="White" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
