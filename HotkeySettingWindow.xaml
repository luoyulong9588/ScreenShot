<Window x:Class="ScreenShot.HotkeySettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置" Width="350" Height="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF2D2D30">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="截屏快捷键" Foreground="#FFB0B0B0" FontSize="14"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="#FF3E3E42" CornerRadius="4" Padding="10,8"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkCtrl" Content="Ctrl" Grid.Column="0"
                          Foreground="#FFB0B0B0" IsChecked="True" Margin="0,0,8,0"/>
                <CheckBox x:Name="ChkShift" Content="Shift" Grid.Column="0"
                          Foreground="#FFB0B0B0" IsChecked="True" Margin="60,0,8,0"/>
                <CheckBox x:Name="ChkAlt" Content="Alt" Grid.Column="0"
                          Foreground="#FFB0B0B0" Margin="140,0,8,0"/>

                <Border Grid.Column="1" Background="#FF1E1E1E" CornerRadius="3"
                        Margin="0,0,8,0">
                    <TextBlock x:Name="TxtKey" Text="A" Foreground="White"
                               FontSize="16" FontWeight="Bold" Padding="10,4"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Button Grid.Column="2" Content="录制" Click="Record_Click"
                        Style="{StaticResource Btn}" Background="#FF0078D4" Foreground="White"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="TxtHint" Text="点击「录制」后按下新的快捷键组合"
                   Foreground="#FF808080" FontSize="12" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Click="Ok_Click" Style="{StaticResource Btn}"
                    Background="#FF0078D4" Foreground="White" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Style="{StaticResource Btn}"
                    Background="#FF555555" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
