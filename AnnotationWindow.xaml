<Window x:Class="ScreenShot.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图标注" WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- 工具按钮样式 -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFB0B0B0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Tool"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,5" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="#FF3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="#FF0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通按钮样式 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FF3E3E42"/>
        </Style>

        <!-- 标题栏拖拽区域 -->
        <Style x:Key="DragArea" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="SizeAll"/>
        </Style>
    </Window.Resources>

    <Border Background="#FF2D2D30" CornerRadius="6" BorderThickness="1"
            BorderBrush="#FF3E3E42">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 + 工具栏 -->
            <DockPanel Grid.Row="0">
                <!-- 拖拽标题栏 -->
                <Border DockPanel.Dock="Top" Style="{StaticResource DragArea}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="截图标注" VerticalAlignment="Center"
                                   Margin="12,0" Foreground="#FFB0B0B0" FontSize="12"/>
                        <!-- 关闭按钮 -->
                        <Button HorizontalAlignment="Right" Width="30" Height="24"
                                Background="Transparent" Click="Cancel_Click"
                                Cursor="Hand" BorderThickness="0">
                            <TextBlock Text="x" Foreground="#FFB0B0B0" FontSize="14"
                                       FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 工具栏 -->
                <Border DockPanel.Dock="Top" Background="#FF2D2D30" Padding="6,2,6,6">
                    <WrapPanel>
                        <RadioButton x:Name="ToolRectangle" Content="&#x25A1; 矩形"
                                     Style="{StaticResource ToolButton}"
                                     Checked="Tool_Checked" IsChecked="True"/>
                        <RadioButton x:Name="ToolArrow" Content="&#x2192; 箭头"
                                     Style="{StaticResource ToolButton}"
                                     Checked="Tool_Checked"/>
                        <RadioButton x:Name="ToolLine" Content="&#x2500; 直线"
                                     Style="{StaticResource ToolButton}"
                                     Checked="Tool_Checked"/>
                        <RadioButton x:Name="ToolPen" Content="&#x270E; 画笔"
                                     Style="{StaticResource ToolButton}"
                                     Checked="Tool_Checked"/>
                        <RadioButton x:Name="ToolText" Content="T 文字"
                                     Style="{StaticResource ToolButton}"
                                     Checked="Tool_Checked"/>
                        <Border Width="1" Background="#FF3E3E42" Margin="6,4"/>
                        <Button Content="&#x21A9; 撤销" Click="Undo_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>
                </Border>
            </DockPanel>

            <!-- 画布区域 -->
            <Border Grid.Row="1" Margin="6,0,6,6" CornerRadius="3"
                    Background="#FF1E1E1E">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="Both">
                    <Grid x:Name="ImageContainer" ClipToBounds="True">
                        <Image x:Name="ScreenshotImage" Stretch="None"/>
                        <Canvas x:Name="DrawingCanvas" Background="Transparent"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                MouseMove="Canvas_MouseMove"
                                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2" Background="#FF2D2D30" Padding="6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制到剪贴板" Click="Copy_Click"
                            Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                    <Button Content="保存到文件" Click="Save_Click"
                            Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                    <Button Content="取消 (Esc)" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
